    ]
  },
  "verify": { "cmd": ["{root}/bin/jadx.bat", "--version"], "match": "1\\.5\\.6", "timeoutMs": 30000 },
  "mcp": {
    "mode": "builtin",
    "provider": "jadx",
    "namespace": "jadx",
