{
  "id": "jadx",
  "name": "jadx",
  "category": "decompile",
  "version": "1.5.6",
  "license": "Apache-2.0",
  "sizeMB": 32,
  "requires": ["jre21"],
  "probe": ["tools/jadx", "%USERPROFILE%/Desktop/mcp服务/re-hub/tools/jadx"],
  "install": {
    "type": "zip",
    "dest": "tools/jadx",
    "stripRoot": true,
    "sources": [
